/* Monocromo hacker — misma paleta que qtile/dunst.
   rofi 2.0 trae un tema solarized por defecto cuyos bloques de estado
   (element selected.normal, .active, urgent...) referencian variables
   propias (background, lightfg, blue, red...). La coherencia se consigue
   redefiniendo ESAS variables con nuestra paleta. */

configuration {
    modes:                 "combi,drun,window,run";
    combi-modes:           "window,drun";
    combi-hide-mode-prefix: true;
    combi-display-format:  "{text}";
    display-combi:         ">";
    display-drun:          ">";
    display-window:        ">";
    font:                  "JetBrainsMono Nerd Font 13";
    show-icons:            false;
    drun-display-format:   "{name}";
    window-format:         "{w} · {c} · {t}";
    sidebar-mode:          false;
}

* {
    /* ── Override del solarized por defecto ─────────────────────────── */
    background: #0a0a0a;
    foreground: #e6e6e6;
    lightbg:    #0a0a0a;
    lightfg:    #e6e6e6;
    blue:       #ff0000;   /* acento (antes azul solarized) */
    red:        #ff0000;

    /* ── Paleta semántica propia ────────────────────────────────────── */
    bg:         #0a0a0a;
    fg:         #e6e6e6;
    dim:        #5c5c5c;
    urgent:     #ff0000;
    sel-bg:     #e6e6e6;
    sel-fg:     #0a0a0a;
    transparent: transparent;
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @fg;
    border-radius:    0;
    width:            620px;
    location:         center;
    anchor:           center;
    cursor:           text;
}

mainbox {
    children:         [ inputbar, message, listview ];
    padding:          14px 16px;
    spacing:          0;
    background-color: transparent;
}

/* ── Barra de entrada: "> texto" como el Prompt de la barra de qtile ── */
inputbar {
    children:         [ prompt, entry ];
    padding:          4px 2px 8px 2px;
    border:           0 0 2px 0;
    border-color:     @dim;
    background-color: transparent;
    text-color:       @fg;
}

prompt {
    padding:          0 8px 0 0;
    background-color: transparent;
    text-color:       @fg;
}

entry {
    padding:           0 0 0 2px;
    background-color:  transparent;
    text-color:        @fg;
    placeholder:       "buscar...";
    placeholder-color: @dim;
    cursor:            text;
}

/* ── Lista: una columna de texto, sin iconos ni bordes punteados ────── */
listview {
    lines:            8;
    columns:          1;
    spacing:          2px;
    fixed-height:     false;
    dynamic:          true;
    scrollbar:        false;
    border:           0;
    padding:          2px 0 0 0;
    background-color: transparent;
}

element {
    padding:          6px 10px;
    background-color: transparent;
    text-color:       @fg;
}

/* Selección: bloque invertido (texto negro sobre blanco) */
element selected {
    background-color: @sel-bg;
    text-color:       @sel-fg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

element-icon {
    background-color: transparent;
    size:             0px;
}

/* ── Extras (dmenu del powermenu, mensajes) ──────────────────────────── */
message {
    border:           2px 0 0 0;
    border-color:     @dim;
    padding:          8px 0 0 0;
    background-color: transparent;
    text-color:       @fg;
}

textbox {
    background-color: transparent;
    text-color:       @fg;
}

scrollbar {
    width:            0px;
    handle-width:     0px;
    background-color: transparent;
    handle-color:     @dim;
}

sidebar {
    border:           0;
}

mode-switcher {
    enabled:          false;
}
