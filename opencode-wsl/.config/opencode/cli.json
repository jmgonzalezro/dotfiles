{
  "$schema": "https://opencode.ai/v2/cli.json",

  "animations": true,

  "diffs": {
    "wrap": "word"
  },

  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "tps": true
  },

  // Notificaciones DESACTIVADAS para el curro (decisión del usuario; WSL no tiene dunst).
  "attention": {
    "notifications": false,
    "sound": false
  },

  // Adjunta el archivo/selección activa de nvim como contexto del prompt.
  "prompt": {
    "editor": true,
    "paste": "compact"
  },

  "terminal": {
    "title": true,
    "copy": "select"
  }
}
